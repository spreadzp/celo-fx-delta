# Required — ERC-8021 tag issued at loops.house enrollment
ATTRIBUTION_CODE=

# x402 mode: self (default, D-191-1 — our tagged settle txs hit the
# leaderboard) or facilitator (env fallback via api.x402.celo.org)
X402_MODE=self
# X402_FACILITATOR_URL=https://api.x402.celo.org
# X402_PRICE_USD=0.005

# Required when X402_MODE=self — wallet submitting tagged txs
# (generated, funded separately; NEVER commit the real key)
SELLER_PRIVATE_KEY=
# SELLER_ADDRESS=

# Celo mainnet
# CELO_RPC_URL=https://forno.celo.org
# CELO_CHAIN_ID=42220

# ERC-8004 registration (191-8): FXDELTA_CHAIN=celoSepolia|celo
# Canonical Identity Registry: 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Gas via fee abstraction (USDC feeCurrency) — CELO not required.
# FXDELTA_CHAIN=celoSepolia
# CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# FX reference cascade (D-191-5): erapi,frankfurter,bcptax — csv, ordered
# FX_PROVIDERS=erapi,frankfurter,bcptax
# FX_TTL_MS=300000

# Optional — Postgres persistence (D-191-14; absent = in-memory + WARN)
# DATABASE_URL=

# Optional — Telegram alerts (both or neither)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
